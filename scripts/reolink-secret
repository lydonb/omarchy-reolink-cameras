#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C
umask 077

fail() {
  local code="$1" message="$2"
  jq -cn --arg code "$code" --arg message "$message" \
    '{ok:false,error:{code:$code,message:$message}}'
  exit 1
}

request=""
trailing=""
IFS= read -r -n 131073 request \
  || [[ -n $request ]] || fail "invalid_request" "Secret request is empty."
((${#request} <= 131072)) || fail "request_too_large" "Secret request exceeds 128 KiB."
if IFS= read -r -t 0.05 -n 1 trailing; then
  fail "invalid_request" "Secret request must be a single bounded line."
fi
jq -e 'type == "object"' <<<"$request" >/dev/null 2>&1 \
  || fail "invalid_request" "Secret request must be exactly one JSON object."
jq -e '
  (.hostId | type == "string" and test("^host_[A-Za-z0-9_-]{1,96}$")) and
  ((.operation == "store" and (keys | sort) == ["hostId","operation","password"]
      and (.password | type == "string" and length >= 1 and length <= 4096
        and (test("[\u0000-\u001f\u007f]") | not)))
    or ((.operation == "clear" or .operation == "exists")
      and (keys | sort) == ["hostId","operation"]))
' <<<"$request" >/dev/null 2>&1 \
  || fail "invalid_request" "Secret request contains invalid or unsupported fields."

operation=$(jq -r '.operation // ""' <<<"$request")
host_id=$(jq -r '.hostId // ""' <<<"$request")
[[ $host_id =~ ^host_[A-Za-z0-9_-]{1,96}$ ]] || fail "invalid_host_id" "Invalid host identifier."

case "$operation" in
  store)
    jq -e '.password | type == "string" and length >= 1 and length <= 4096
      and (test("[\u0000-\u001f\u007f]") | not)' <<<"$request" >/dev/null 2>&1 \
      || fail "invalid_password" "Password must be 1 to 4096 characters without control characters."
    password=$(jq -r '.password' <<<"$request")
    printf '%s' "$password" \
      | timeout 20s secret-tool store \
          --label='Omarchy Reolink camera password' \
          application omarchy-reolink host-id "$host_id" kind password \
          >/dev/null 2>&1 \
      || fail "secret_store_failed" "The desktop keyring did not store the password."
    unset password
    jq -cn '{ok:true}'
    ;;

  clear)
    set +e
    clear_output=$(timeout 20s secret-tool clear \
      application omarchy-reolink host-id "$host_id" kind password 2>&1)
    clear_rc=$?
    set -e
    [[ $clear_rc == 0 || ( $clear_rc == 1 && -z $clear_output ) ]] \
      || fail "secret_clear_failed" "The desktop keyring did not clear the password."
    unset clear_output
    set +e
    verify_output=$(timeout 20s secret-tool lookup \
      application omarchy-reolink host-id "$host_id" kind password 2>&1)
    verify_rc=$?
    set -e
    if [[ $verify_rc == 0 ]]; then
      unset verify_output
      fail "secret_clear_failed" "The desktop keyring still contains the password."
    fi
    [[ $verify_rc == 1 && -z $verify_output ]] \
      || fail "secret_clear_failed" "The desktop keyring could not verify password removal."
    unset verify_output
    jq -cn '{ok:true}'
    ;;

  exists)
    set +e
    value=$(timeout 20s secret-tool lookup \
      application omarchy-reolink host-id "$host_id" kind password 2>&1)
    lookup_rc=$?
    set -e
    if [[ $lookup_rc == 0 ]]; then
      unset value
      jq -cn '{ok:true,exists:true}'
    elif [[ $lookup_rc == 1 && -z $value ]]; then
      unset value
      jq -cn '{ok:true,exists:false}'
    else
      unset value
      fail "secret_lookup_failed" "The desktop keyring could not check the password."
    fi
    ;;

  *) fail "operation_denied" "Unsupported Secret Service operation." ;;
esac
